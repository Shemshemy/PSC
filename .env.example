# Public Service Commission (PSC) Kenya - Production Environment Variables
# Copy this file to .env before starting the production deployment

NODE_ENV=production
PORT=5000

# Security & CORS (Set to your exact public domain in production, e.g. https://psc.go.ke)
CORS_ORIGIN=*

# Cryptographic Key Identifier for ALFE Field Encryption
KMS_KEY_ID=arn:aws:kms:af-south-1:psc-hsm-01

# Rate Limiter Configuration (Token bucket capacity per IP per minute)
RATE_LIMIT_MAX=100

# Database Connection Pool Emulation (PgBouncer)
DB_POOL_MAX=20

# Upstream Integrations
IPRS_ENDPOINT=https://iprs.ecitizen.go.ke/v2/verify
KNEC_ENDPOINT=https://knec.go.ke/api/results
GHRIS_ENDPOINT=https://ghris.go.ke/api/payroll
